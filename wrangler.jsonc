{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quote-to-cash",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "public" },
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Quotes at or above this total (cents) pause for a human; below it the policy auto-approves.
    "APPROVAL_THRESHOLD_CENTS": "1000000",
    // Dunning schedule is written in days. This is how many SECONDS one day takes in this deployment.
    // Production: 86400. Demo: 5, so the whole 1d/3d/7d sequence plays out in under a minute.
    "SECONDS_PER_DAY": "5",
    // Spend guard for an unauthenticated demo. Prices are Workers AI's published USD per million
    // tokens for the model above (developers.cloudflare.com/workers-ai/platform/pricing).
    "AI_DAILY_CAP_USD": "5",
    "AI_PRICE_IN_PER_M": "0.293",
    "AI_PRICE_OUT_PER_M": "2.253",
    // Per-IP quota counts quotes (not the several LLM calls an agent loop makes per quote).
    "AI_IP_DAILY_QUOTES": "150",
    "AI_BURST_MS": "400"
  },
  // One CustomerAccount per customer: deal history, pending approvals, invoices, payments, notifications.
  "durable_objects": { "bindings": [
    { "name": "ACCOUNT", "class_name": "CustomerAccount" },
    // Singleton spend guard: daily AI budget, per-IP quota, burst limit.
    { "name": "BUDGET", "class_name": "Budget" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CustomerAccount"] },
    { "tag": "v2", "new_sqlite_classes": ["Budget"] }
  ],
  // One QuoteToCash Workflow instance per deal: price → policy → (approval) → invoice → payment → dunning.
  "workflows": [{ "name": "quote-to-cash", "binding": "PIPELINE", "class_name": "QuoteToCash" }],
  "observability": { "enabled": true }
}
